#!/bin/bash
# info: delete reseller account and optionally all child users
# options: USER [DELETE_CHILDREN]

user=$1
delete_children=${2-no}

source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source $HESTIA/func/reseller.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [DELETE_CHILDREN]'
is_format_valid 'user'
check_hestia_demo_mode

is_reseller_account "$user" || {
	echo "Error: $user is not a reseller"
	exit "$E_NOTEXIST"
}

if [ "$delete_children" = "yes" ]; then
	while read -r child; do
		[ -z "$child" ] && continue
		$BIN/v-delete-reseller-user "$user" "$child" yes
	done < <(reseller_list_children "$user")
else
	child_count=$(reseller_count_children "$user")
	if [ "$child_count" -gt 0 ]; then
		echo "Error: reseller has $child_count hosting users. Use DELETE_CHILDREN=yes or remove users first."
		exit "$E_INUSE"
	fi
fi

rm -rf "${RESELLER_DATA}/$user"
$BIN/v-delete-user "$user"
$BIN/v-log-action "system" "Info" "Reseller" "Reseller account deleted (Name: $user)."
log_event "$OK" "$ARGUMENTS"
exit 0
