#!/bin/bash
# info: link hosting user to reseller (users.list + RESELLER_OWNER)
# options: RESELLER CHILD_USER

reseller=$1
child=$2

source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source $HESTIA/func/reseller.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'RESELLER CHILD_USER'
is_format_valid 'user'
check_hestia_demo_mode

is_reseller_account "$reseller" || {
	echo "Error: $reseller is not a reseller"
	exit "$E_NOTEXIST"
}

is_object_valid 'user' 'CHILD_USER' "$child" || exit "$E_NOTEXIST"

reseller_link_child "$reseller" "$child"
reseller_sync_counters "$reseller"

echo "OK: $child linked to reseller $reseller"
exit 0
