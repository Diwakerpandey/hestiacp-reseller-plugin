#!/bin/bash
# info: create a reseller account
# options: USER PASSWORD EMAIL RESELLER_PACKAGE [NAME]

user=$1
password=$2
HIDE=2
email=$3
reseller_package=$4
name=${5:-$user}

source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source $HESTIA/func/reseller.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '4' "$#" 'USER PASSWORD EMAIL RESELLER_PACKAGE [NAME]'
is_format_valid 'user' 'email' 'package'
is_password_valid
check_hestia_demo_mode

[ -f "${RESELLER_PKG_DIR}/${reseller_package}.pkg" ] || {
	echo "Error: reseller package $reseller_package not found"
	exit "$E_NOTEXIST"
}

is_reseller_account "$user" && {
	echo "Error: $user is already a reseller"
	exit "$E_EXISTS"
}

# Create panel user with minimal reseller-system package
$BIN/v-add-user "$user" "$password" "$email" "reseller-system" "$name"
rc=$?
[ $rc -eq 0 ] || exit $rc

# Promote to reseller role
update_user_value "$user" 'ROLE' 'reseller'

mkdir -p "${RESELLER_DATA}/$user"
# shellcheck disable=SC1090
source "${RESELLER_PKG_DIR}/${reseller_package}.pkg"

time_n_date=$(date +'%T %F')
date=$(echo "$time_n_date" | cut -f 2 -d \ )

cat > "$(reseller_conf_path "$user")" <<EOF
RESELLER_PACKAGE='$reseller_package'
MAX_USERS='${MAX_USERS:-10}'
MAX_DISK='${MAX_DISK:-unlimited}'
MAX_BANDWIDTH='${MAX_BANDWIDTH:-unlimited}'
ALLOWED_PACKAGES='${ALLOWED_PACKAGES:-default}'
R_USERS='0'
R_DISK='0'
R_BANDWIDTH='0'
DATE='$date'
EOF
chmod 640 "$(reseller_conf_path "$user")"
touch "$(reseller_users_list "$user")"
chmod 640 "$(reseller_users_list "$user")"

$BIN/v-log-action "system" "Info" "Reseller" "Reseller account added (Name: $user, Package: $reseller_package)."
log_event "$OK" "$ARGUMENTS"
exit 0
