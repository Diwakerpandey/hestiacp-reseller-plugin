#!/bin/bash
# info: verify hosting user belongs to reseller
# options: RESELLER CHILD_USER

reseller=$1
child=$2

source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source $HESTIA/func/reseller.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'RESELLER CHILD_USER'
is_format_valid 'user'

is_reseller_account "$reseller" || exit "$E_NOTEXIST"
is_object_valid 'user' 'CHILD_USER' "$child" || exit "$E_NOTEXIST"

if reseller_owns_child_user "$reseller" "$child"; then
	exit 0
fi

echo "Error: user $child is not owned by reseller $reseller"
exit "$E_INVALID"
